# Copy this file to .env or fill these values in /install.php.
# Use absolute paths for shared hosting when possible.

FACEAUTH_CORE_URL=https://core.example.com
FACEAUTH_TENANT_ID=tenant_demo
FACEAUTH_TENANT_SECRET=replace_with_core_tenant_secret
FACEAUTH_MOODLE_SHARED_SECRET=replace_with_moodle_shared_secret

FACEAUTH_STORAGE_PHOTOS=/absolute/path/to/faceauth-backend/storage/photos
FACEAUTH_STORAGE_LOGS=/absolute/path/to/faceauth-backend/storage/logs
FACEAUTH_LICENSE_CACHE=/absolute/path/to/faceauth-backend/storage/license-cache.json
FACEAUTH_USERS_FILE=/absolute/path/to/faceauth-backend/storage/users.json
