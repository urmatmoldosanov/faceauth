FACEAUTH_CORE_URL=https://core.example.com
FACEAUTH_TENANT_ID=tenant_demo
FACEAUTH_TENANT_SECRET=replace_with_core_tenant_secret
FACEAUTH_MOODLE_SHARED_SECRET=replace_with_moodle_shared_secret
FACEAUTH_STORAGE_PHOTOS=../storage/photos
FACEAUTH_STORAGE_LOGS=../storage/logs
FACEAUTH_LICENSE_CACHE=../storage/license-cache.json
FACEAUTH_DB_PATH=../storage/faceauth.sqlite
FACEAUTH_RETENTION_DAYS=30
FACEAUTH_BACKEND_MAINTENANCE_TOKEN=replace_with_very_long_random_token
FACEAUTH_ADMIN_USER=admin
FACEAUTH_ADMIN_PASS_HASH=$2y$10$replace_with_password_hash
FACEAUTH_VIEWER_USER=viewer
FACEAUTH_VIEWER_PASS_HASH=$2y$10$replace_with_password_hash
